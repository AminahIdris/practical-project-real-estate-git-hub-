# Application
APP_ENV=development
APP_SECRET_KEY=replace-me-with-a-strong-random-secret
API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# Database (used by docker-compose and backend)
POSTGRES_DB=real_estate
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://app_user:change-me@localhost:5432/real_estate

# AI provider
AI_PROVIDER=openai
AI_API_KEY=replace-me
AI_MODEL=gpt-4o-mini

# n8n
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=replace-me

# Optional – notification providers (add when implementing)
# SLACK_WEBHOOK_URL=
# EMAIL_SMTP_HOST=
